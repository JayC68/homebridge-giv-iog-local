{
  "name": "homebridge-giv-iog-local",
  "version": "4.0.2",
  "description": "Direct local GivEnergy integration for Homebridge with Apple Home telemetry and control, Intelligent Octopus Go, Flux and Agile export intelligence, Eve Energy history and Predicted Solar.",
  "main": "index.js",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "givenergy",
    "givhome",
    "modbus",
    "local-control",
    "apple-home",
    "homekit",
    "intelligent-octopus-go",
    "octopus-energy",
    "octopus-flux",
    "agile-export",
    "battery-export",
    "energy-automation",
    "eve",
    "energy-history",
    "eve-energy-graphs",
    "fakegato-history",
    "predicted-solar",
    "solar-forecast"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "test": "node tools/verify-release.js && node tools/predicted-solar-harness.js && node tools/verify-release-notes.js && TZ=Europe/London node --test tools/charge-lifecycle.test.js tools/charge-target.test.js",
    "verify": "node tools/verify-release.js && node tools/predicted-solar-harness.js && node tools/verify-release-notes.js && TZ=Europe/London node --test tools/charge-lifecycle.test.js tools/charge-target.test.js",
    "test:hap": "node --test tools/charge-target-hap.test.js",
    "pack:dry": "npm pack --dry-run"
  },
  "files": [
    "index.js",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "LICENSE",
