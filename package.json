    "TRADEMARKS.md",
    "SECURITY.md",
    "SUPPORT.md",
    "assets",
    "docs",
    "lib",
    "tools/verify-release.js",
    "tools/predicted-solar-harness.js",
    "tools/verify-release-notes.js",
    "tools/charge-lifecycle.test.js",
    "tools/charge-target.test.js",
    "tools/charge-target-hap.test.js"
  ],
  "displayName": "GivHome",
