{
  "pluginAlias": "GivEnergy Local + Intelligent Octopus Go",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Local Homebridge bridge for GivTCP telemetry with Intelligent Octopus Go charging control. Release 3.2.4 includes the proven REST-based Force Charge / Force Export fixes and SoC tile correction.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "GivEnergy IOG"
      },
      "mqttUrl": {
        "title": "MQTT URL",
        "type": "string",
        "default": "mqtt://192.168.0.49:1884"
      },
      "mqttUsername": {
        "title": "MQTT Username",
        "type": "string",
        "default": ""
      },
      "mqttPassword": {
        "title": "MQTT Password",
        "type": "string",
        "default": ""
      },
      "mqttRootTopic": {
        "title": "MQTT Root Topic",
        "type": "string",
        "default": "GivEnergy"
      },
      "inverterSerial": {
        "title": "Inverter Serial",
        "type": "string",
        "default": "CH2344G083"
      },
      "octopusApiKey": {
        "title": "Octopus API Key",
        "type": "string",
        "default": ""
      },
      "octopusAccountNumber": {
        "title": "Octopus Account Number",
        "type": "string",
        "default": ""
      },
      "octopusPollSeconds": {
        "title": "Octopus Poll Seconds",
        "type": "integer",
        "default": 120,
        "minimum": 30,
        "maximum": 1800
      },
      "cheapStart": {
        "title": "Fallback Cheap Window Start",
        "type": "string",
        "default": "23:30"
      },
      "cheapEnd": {
        "title": "Fallback Cheap Window End",
        "type": "string",
        "default": "05:30"
      },
      "graceMinutes": {
        "title": "Grace Minutes",
        "type": "integer",
        "default": 30,
        "minimum": 0,
        "maximum": 180
      },
      "targetSoc": {
        "title": "Default Target SoC %",
        "type": "integer",
        "default": 100,
        "minimum": 1,
        "maximum": 100
      },
      "batteryUsableCapacityKwh": {
        "title": "Battery Usable Capacity kWh",
        "type": "number",
        "default": 13.5,
        "minimum": 0.1,
        "maximum": 200
      },
      "maxChargePowerKw": {
        "title": "Maximum Charge Power kW",
        "type": "number",
        "default": 6.0,
        "minimum": 0.1,
        "maximum": 50
      },
      "maxPvKw": {
        "title": "Maximum PV kW",
        "type": "number",
        "default": 2.88,
        "minimum": 0.1,
        "maximum": 100
      },
      "smartWindowsJson": {
        "title": "Manual Smart Windows JSON",
        "type": "string",
        "default": "[]",
        "description": "Optional extra cheap windows, e.g. [{\"start\":\"13:30\",\"end\":\"15:00\"}]"
      },
      "forceChargeMinutes": {
        "title": "Manual Force Charge Minutes",
        "type": "integer",
        "default": 60,
        "minimum": 1,
        "maximum": 1440
      },
      "forceExportMinutes": {
        "title": "Manual Force Export Minutes",
        "type": "integer",
        "default": 60,
        "minimum": 1,
        "maximum": 1440
      },
      "lowBatteryThreshold": {
        "title": "Low Battery Threshold %",
        "type": "integer",
        "default": 20,
        "minimum": 1,
        "maximum": 100
      },
      "powerActiveThreshold": {
        "title": "Power Active Threshold W",
        "type": "integer",
        "default": 20,
        "minimum": 0,
        "maximum": 5000
      },
      "staleSeconds": {
        "title": "Telemetry Stale Seconds",
        "type": "integer",
        "default": 180,
        "minimum": 30,
        "maximum": 3600
      },
      "givTcpRestUrl": {
        "title": "GivTCP REST URL",
        "type": "string",
        "default": "http://127.0.0.1:6345"
      }
    }
  }
}
